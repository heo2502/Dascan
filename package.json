{
  "name": "dascan",
  "version": "1.1.2",
  "private": true,
  "description": "다스캔 - 여러 AI를 한 화면에서 질문하고 비교하는 데스크톱 앱",
  "author": "Dascan",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "kr.dascan.app",
    "productName": "다스캔",
    "asar": true,
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraMetadata": { "publisher": "Dascan" },
    "directories": { "output": "release" },
    "win": { "target": ["nsis"], "artifactName": "Dascan-Setup-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": true, "allowElevation": true, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "다스캔", "uninstallDisplayName": "다스캔 ${version}", "include": "build/installer.nsh", "deleteAppDataOnUninstall": false }
  }
}
